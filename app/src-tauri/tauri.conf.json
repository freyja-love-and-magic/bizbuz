{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BizBuz",
  "version": "0.3.0",
  "identifier": "club.home.bizbuz",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BizBuz",
        "width": 390,
        "height": 844,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#F7F9FA"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0",
      "developmentTeam": "PCUFMY9NKZ"
    }
  }
}
